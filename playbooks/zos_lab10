---
- name: Create QSAM data set using TSO
  hosts: zos
  gather_facts: false
  environment: "{{ environment_vars }}"

  tasks:
    - name: Allocate QSAM data set
      ibm.ibm_zos_core.zos_tso_command:
        commands:
          - "ALLOCATE DATASET('JAMES.LAB10') NEW CATALOG SPACE(2,4) TRACKS RECFM(F B) LRECL(80) BLKSIZE(8000) DSORG(PS)"
      register: result

    - name: Display result
      ansible.builtin.debug:
        var: result
